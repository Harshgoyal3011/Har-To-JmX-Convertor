{
  "log": {
    "version": "1.2",
    "creator": { "name": "user-scoped", "version": "1" },
    "entries": [
      {
        "startedDateTime": "2026-01-01T10:00:00.000Z", "time": 50,
        "comment": "login issues a per-session token",
        "request": { "method": "POST", "url": "https://app.example.com/auth",
          "headers": [ { "name": "Content-Type", "value": "application/json" } ], "cookies": [],
          "postData": { "mimeType": "application/json", "text": "{\"username\": \"jdoe\", \"password\": \"Secret@1\"}" } },
        "response": { "status": 200, "headers": [ { "name": "Content-Type", "value": "application/json" } ],
          "content": { "mimeType": "application/json", "text": "{\"sessionToken\": \"SESS-abc123xyz\", \"uid\": \"UID-55021\"}" } }
      },
      {
        "startedDateTime": "2026-01-01T10:00:01.000Z", "time": 60,
        "comment": "user-scoped list: its path carries the per-session uid, so the accounts it returns are user-owned",
        "request": { "method": "GET", "url": "https://app.example.com/users/UID-55021/accounts",
          "headers": [ { "name": "Authorization", "value": "Bearer SESS-abc123xyz" } ], "cookies": [] },
        "response": { "status": 200, "headers": [ { "name": "Content-Type", "value": "application/json" } ],
          "content": { "mimeType": "application/json", "text": "{\"accounts\": [{\"accountId\": \"ACC-778812\", \"kind\": \"CHECKING\"}]}" } }
      },
      {
        "startedDateTime": "2026-01-01T10:00:02.000Z", "time": 55,
        "comment": "shared catalog: no session id in the path, ids are the same for everyone",
        "request": { "method": "GET", "url": "https://app.example.com/products",
          "headers": [ { "name": "Authorization", "value": "Bearer SESS-abc123xyz" } ], "cookies": [] },
        "response": { "status": 200, "headers": [ { "name": "Content-Type", "value": "application/json" } ],
          "content": { "mimeType": "application/json", "text": "{\"products\": [{\"productId\": \"PROD-4400\", \"name\": \"Widget\"}]}" } }
      },
      {
        "startedDateTime": "2026-01-01T10:00:03.000Z", "time": 40,
        "comment": "consume the user-owned account id in a later path",
        "request": { "method": "GET", "url": "https://app.example.com/accounts/ACC-778812/balance",
          "headers": [ { "name": "Authorization", "value": "Bearer SESS-abc123xyz" } ], "cookies": [] },
        "response": { "status": 200, "headers": [ { "name": "Content-Type", "value": "application/json" } ],
          "content": { "mimeType": "application/json", "text": "{\"balance\": 1200.00}" } }
      },
      {
        "startedDateTime": "2026-01-01T10:00:04.000Z", "time": 45,
        "comment": "consume the shared product id in a later path",
        "request": { "method": "GET", "url": "https://app.example.com/products/PROD-4400/reviews",
          "headers": [ { "name": "Authorization", "value": "Bearer SESS-abc123xyz" } ], "cookies": [] },
        "response": { "status": 200, "headers": [ { "name": "Content-Type", "value": "application/json" } ],
          "content": { "mimeType": "application/json", "text": "{\"reviews\": []}" } }
      }
    ]
  }
}
