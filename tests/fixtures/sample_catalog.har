{
  "log": {
    "version": "1.2",
    "creator": { "name": "correlation-catalog-probe", "version": "1.0" },
    "entries": [
      {
        "startedDateTime": "2026-01-01T10:00:00.000Z", "time": 60,
        "comment": "List patients — response carries a continuation/pagination token",
        "request": { "method": "GET", "url": "https://his.example.com/api/patients?limit=2", "headers": [ { "name": "Accept", "value": "application/json" } ], "cookies": [] },
        "response": { "status": 200, "headers": [ { "name": "Content-Type", "value": "application/json" } ],
          "content": { "mimeType": "application/json", "text": "{\"patients\":[{\"patientId\":\"PAT-9001\",\"patientName\":\"Asha\",\"doctorId\":\"DOC-55\"},{\"patientId\":\"PAT-9002\",\"patientName\":\"Ravi\",\"doctorId\":\"DOC-72\"}],\"nextPageToken\":\"CURSOR-eyJvZmZzZXQiOjJ9\"}" } }
      },
      {
        "startedDateTime": "2026-01-01T10:00:03.000Z", "time": 55,
        "comment": "Next page — consumes the continuation token in the query",
        "request": { "method": "GET", "url": "https://his.example.com/api/patients?limit=2&pageToken=CURSOR-eyJvZmZzZXQiOjJ9", "headers": [ { "name": "Accept", "value": "application/json" } ], "cookies": [] },
        "response": { "status": 200, "headers": [ { "name": "Content-Type", "value": "application/json" } ],
          "content": { "mimeType": "application/json", "text": "{\"patients\":[{\"patientId\":\"PAT-9003\",\"patientName\":\"Meera\",\"doctorId\":\"DOC-55\"}],\"nextPageToken\":\"\"}" } }
      },
      {
        "startedDateTime": "2026-01-01T10:00:06.000Z", "time": 45,
        "comment": "Open patient — response returns an ETag (version/lock token)",
        "request": { "method": "GET", "url": "https://his.example.com/api/patients/PAT-9001", "headers": [ { "name": "Accept", "value": "application/json" } ], "cookies": [] },
        "response": { "status": 200, "headers": [ { "name": "Content-Type", "value": "application/json" }, { "name": "ETag", "value": "\"ver-3-a1b2c3d4\"" } ],
          "content": { "mimeType": "application/json", "text": "{\"patientId\":\"PAT-9001\",\"patientName\":\"Asha\",\"doctorId\":\"DOC-55\",\"phone\":\"9876543210\"}" } }
      },
      {
        "startedDateTime": "2026-01-01T10:00:09.000Z", "time": 70,
        "comment": "Update patient — optimistic concurrency: sends the ETag back as If-Match",
        "request": { "method": "PUT", "url": "https://his.example.com/api/patients/PAT-9001",
          "headers": [ { "name": "Content-Type", "value": "application/json" }, { "name": "If-Match", "value": "\"ver-3-a1b2c3d4\"" } ], "cookies": [],
          "postData": { "mimeType": "application/json", "text": "{\"patientId\":\"PAT-9001\",\"phone\":\"9998887776\"}" } },
        "response": { "status": 200, "headers": [ { "name": "Content-Type", "value": "application/json" }, { "name": "ETag", "value": "\"ver-4-e5f6g7h8\"" } ],
          "content": { "mimeType": "application/json", "text": "{\"result\":\"updated\"}" } }
      },
      {
        "startedDateTime": "2026-01-01T10:00:12.000Z", "time": 80,
        "comment": "Book appointment — created appointmentId (runtime); consumes existing patient + doctor",
        "request": { "method": "POST", "url": "https://his.example.com/api/appointments",
          "headers": [ { "name": "Content-Type", "value": "application/json" } ], "cookies": [],
          "postData": { "mimeType": "application/json", "text": "{\"patientId\":\"PAT-9001\",\"doctorId\":\"DOC-55\",\"slot\":\"2026-02-01T10:00:00\"}" } },
        "response": { "status": 201, "headers": [ { "name": "Content-Type", "value": "application/json" } ],
          "content": { "mimeType": "application/json", "text": "{\"appointmentId\":\"APPT-7788\",\"status\":\"BOOKED\"}" } }
      },
      {
        "startedDateTime": "2026-01-01T10:00:15.000Z", "time": 40,
        "comment": "Open appointment — consumes the created appointmentId",
        "request": { "method": "GET", "url": "https://his.example.com/api/appointments/APPT-7788", "headers": [ { "name": "Accept", "value": "application/json" } ], "cookies": [] },
        "response": { "status": 200, "headers": [ { "name": "Content-Type", "value": "application/json" } ],
          "content": { "mimeType": "application/json", "text": "{\"appointmentId\":\"APPT-7788\",\"status\":\"BOOKED\"}" } }
      }
    ]
  }
}
