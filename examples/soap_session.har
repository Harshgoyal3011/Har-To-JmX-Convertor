{
  "log": {
    "version": "1.2",
    "creator": { "name": "soap-session-probe", "version": "1.0" },
    "entries": [
      {
        "startedDateTime": "2026-01-01T10:00:00.000Z", "time": 120,
        "comment": "SOAP Login — server returns a SessionId in the XML response",
        "request": { "method": "POST", "url": "https://erp.example.com/services/AuthService",
          "headers": [ { "name": "Content-Type", "value": "text/xml; charset=utf-8" }, { "name": "SOAPAction", "value": "\"http://erp.example.com/Login\"" } ], "cookies": [],
          "postData": { "mimeType": "text/xml", "text": "<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\"><soap:Body><Login xmlns=\"http://erp.example.com/\"><username>svc_user</username><password>Secret123</password></Login></soap:Body></soap:Envelope>" } },
        "response": { "status": 200, "headers": [ { "name": "Content-Type", "value": "text/xml; charset=utf-8" } ],
          "content": { "mimeType": "text/xml", "text": "<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\"><soap:Body><LoginResponse xmlns=\"http://erp.example.com/\"><SessionId>SESS-7a9f2c1e-4b8d-11ef</SessionId></LoginResponse></soap:Body></soap:Envelope>" } }
      },
      {
        "startedDateTime": "2026-01-01T10:00:03.000Z", "time": 140,
        "comment": "SOAP GetOrder — consumes the SessionId in the header, sends a user-supplied orderNumber",
        "request": { "method": "POST", "url": "https://erp.example.com/services/OrderService",
          "headers": [ { "name": "Content-Type", "value": "text/xml; charset=utf-8" }, { "name": "SOAPAction", "value": "\"http://erp.example.com/GetOrder\"" } ], "cookies": [],
          "postData": { "mimeType": "text/xml", "text": "<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\"><soap:Header><SessionId xmlns=\"http://erp.example.com/\">SESS-7a9f2c1e-4b8d-11ef</SessionId></soap:Header><soap:Body><GetOrder xmlns=\"http://erp.example.com/\"><orderNumber>PO-2026-00457</orderNumber></GetOrder></soap:Body></soap:Envelope>" } },
        "response": { "status": 200, "headers": [ { "name": "Content-Type", "value": "text/xml; charset=utf-8" } ],
          "content": { "mimeType": "text/xml", "text": "<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\"><soap:Body><GetOrderResponse xmlns=\"http://erp.example.com/\"><orderId>ORD-88231</orderId><customerName>Acme Corp</customerName></GetOrderResponse></soap:Body></soap:Envelope>" } }
      },
      {
        "startedDateTime": "2026-01-01T10:00:06.000Z", "time": 100,
        "comment": "SOAP UpdateOrder — consumes SessionId AND the server-returned orderId",
        "request": { "method": "POST", "url": "https://erp.example.com/services/OrderService",
          "headers": [ { "name": "Content-Type", "value": "text/xml; charset=utf-8" }, { "name": "SOAPAction", "value": "\"http://erp.example.com/UpdateOrder\"" } ], "cookies": [],
          "postData": { "mimeType": "text/xml", "text": "<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\"><soap:Header><SessionId xmlns=\"http://erp.example.com/\">SESS-7a9f2c1e-4b8d-11ef</SessionId></soap:Header><soap:Body><UpdateOrder xmlns=\"http://erp.example.com/\"><orderId>ORD-88231</orderId><status>SHIPPED</status></UpdateOrder></soap:Body></soap:Envelope>" } },
        "response": { "status": 200, "headers": [ { "name": "Content-Type", "value": "text/xml; charset=utf-8" } ],
          "content": { "mimeType": "text/xml", "text": "<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\"><soap:Body><UpdateOrderResponse xmlns=\"http://erp.example.com/\"><result>OK</result></UpdateOrderResponse></soap:Body></soap:Envelope>" } }
      }
    ]
  }
}
