{
  "log": {
    "version": "1.2",
    "creator": { "name": "complex-saml", "version": "1" },
    "entries": [
      {
        "startedDateTime": "2026-01-01T10:00:00.000Z", "time": 60,
        "comment": "SP-initiated: app redirects to IdP with SAMLRequest + RelayState in the Location",
        "request": { "method": "GET", "url": "https://sp.example.com/app", "headers": [ { "name": "Accept", "value": "text/html" } ], "cookies": [] },
        "response": { "status": 302, "headers": [ { "name": "Location", "value": "https://idp.example.com/sso?SAMLRequest=fZFRa8IwFIX%2FSsl7m6TVaYMtDGEgOB%2Bmex9pcqcBmtTctPv7dXNj7GHP53znch5uhTr0Y7EY%2FTG8w2UEP4mvvnc4nZuygj56g51x&RelayState=rs-token-88213abc9d" } ],
          "content": { "mimeType": "text/html", "text": "" } }
      },
      {
        "startedDateTime": "2026-01-01T10:00:00.400Z", "time": 70,
        "comment": "IdP login page — carries RelayState in a hidden field",
        "request": { "method": "GET", "url": "https://idp.example.com/sso?SAMLRequest=fZFRa8IwFIX%2FSsl7m6TVaYMtDGEgOB%2Bmex9pcqcBmtTctPv7dXNj7GHP53znch5uhTr0Y7EY%2FTG8w2UEP4mvvnc4nZuygj56g51x&RelayState=rs-token-88213abc9d", "headers": [ { "name": "Accept", "value": "text/html" } ], "cookies": [] },
        "response": { "status": 200, "headers": [ { "name": "Content-Type", "value": "text/html" } ],
          "content": { "mimeType": "text/html", "text": "<html><body><form method=\"post\" action=\"/login\"><input type=\"hidden\" name=\"RelayState\" value=\"rs-token-88213abc9d\"/><input name=\"username\"/><input name=\"password\" type=\"password\"/></form></body></html>" } }
      },
      {
        "startedDateTime": "2026-01-01T10:00:08.000Z", "time": 120,
        "comment": "Submit IdP credentials — IdP returns an auto-post form with SAMLResponse to the SP ACS",
        "request": { "method": "POST", "url": "https://idp.example.com/login",
          "headers": [ { "name": "Content-Type", "value": "application/x-www-form-urlencoded" } ], "cookies": [],
          "postData": { "mimeType": "application/x-www-form-urlencoded",
            "params": [ { "name": "username", "value": "jsmith" }, { "name": "password", "value": "Federate@2026" }, { "name": "RelayState", "value": "rs-token-88213abc9d" } ] } },
        "response": { "status": 200, "headers": [ { "name": "Content-Type", "value": "text/html" } ],
          "content": { "mimeType": "text/html", "text": "<html><body onload=\"document.forms[0].submit()\"><form method=\"post\" action=\"https://sp.example.com/acs\"><input type=\"hidden\" name=\"SAMLResponse\" value=\"PHNhbWxwOlJlc3BvbnNlIHhtbG5zPQ0KICB4bWxuczpzYW1sPSJ1cm46b2FzaXM6bmFtZXM6dGM6U0FNTDoyLjA6YXNzZXJ0aW9uIj48c2FtbDpJc3N1ZXI%2BaWRwPC9zYW1sOklzc3Vlcj48L3NhbWxwOlJlc3BvbnNlPg==\"/><input type=\"hidden\" name=\"RelayState\" value=\"rs-token-88213abc9d\"/></form></body></html>" } }
      },
      {
        "startedDateTime": "2026-01-01T10:00:09.000Z", "time": 90,
        "comment": "SP ACS consumes the SAMLResponse + RelayState, sets a session, redirects to the app",
        "request": { "method": "POST", "url": "https://sp.example.com/acs",
          "headers": [ { "name": "Content-Type", "value": "application/x-www-form-urlencoded" } ], "cookies": [],
          "postData": { "mimeType": "application/x-www-form-urlencoded",
            "params": [ { "name": "SAMLResponse", "value": "PHNhbWxwOlJlc3BvbnNlIHhtbG5zPQ0KICB4bWxuczpzYW1sPSJ1cm46b2FzaXM6bmFtZXM6dGM6U0FNTDoyLjA6YXNzZXJ0aW9uIj48c2FtbDpJc3N1ZXI+aWRwPC9zYW1sOklzc3Vlcj48L3NhbWxwOlJlc3BvbnNlPg==" }, { "name": "RelayState", "value": "rs-token-88213abc9d" } ] } },
        "response": { "status": 302, "headers": [ { "name": "Location", "value": "https://sp.example.com/dashboard" }, { "name": "Set-Cookie", "value": "SPSESSION=SPSESSION-9a8b7c6d5e; Path=/; HttpOnly" } ],
          "content": { "mimeType": "text/html", "text": "" } }
      },
      {
        "startedDateTime": "2026-01-01T10:00:10.000Z", "time": 80,
        "comment": "App loads authenticated with the SP session",
        "request": { "method": "GET", "url": "https://sp.example.com/dashboard", "headers": [ { "name": "Accept", "value": "text/html" } ], "cookies": [ { "name": "SPSESSION", "value": "SPSESSION-9a8b7c6d5e" } ] },
        "response": { "status": 200, "headers": [ { "name": "Content-Type", "value": "text/html" } ],
          "content": { "mimeType": "text/html", "text": "<html><body>Welcome jsmith</body></html>" } }
      }
    ]
  }
}
