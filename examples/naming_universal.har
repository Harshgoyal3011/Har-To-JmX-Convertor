{
  "log": {
    "version": "1.2",
    "creator": { "name": "naming-universality-probe", "version": "1.0" },
    "entries": [
      {
        "startedDateTime": "2026-01-01T10:00:00.000Z", "time": 60,
        "comment": "List existing products — product identity first appears here as camelCase productId",
        "request": { "method": "GET", "url": "https://shop.example.com/api/catalog", "headers": [ { "name": "Accept", "value": "application/json" } ], "cookies": [] },
        "response": { "status": 200, "headers": [ { "name": "Content-Type", "value": "application/json" } ],
          "content": { "mimeType": "application/json", "text": "{\"products\":[{\"productId\":\"SKU-88231-ALPHA\",\"title\":\"Widget\"},{\"productId\":\"SKU-99000-BETA\",\"title\":\"Gadget\"}]}" } }
      },
      {
        "startedDateTime": "2026-01-01T10:00:03.000Z", "time": 40,
        "comment": "Open product — SAME value now in the URL path AND response as snake_case product_id",
        "request": { "method": "GET", "url": "https://shop.example.com/api/products/SKU-88231-ALPHA", "headers": [ { "name": "Accept", "value": "application/json" } ], "cookies": [] },
        "response": { "status": 200, "headers": [ { "name": "Content-Type", "value": "application/json" } ],
          "content": { "mimeType": "application/json", "text": "{\"product_id\":\"SKU-88231-ALPHA\",\"stock\":50,\"price\":19.99}" } }
      },
      {
        "startedDateTime": "2026-01-01T10:00:06.000Z", "time": 55,
        "comment": "Add to cart — SAME value posted as PascalCase ProductID",
        "request": { "method": "POST", "url": "https://shop.example.com/api/cart", "headers": [ { "name": "Content-Type", "value": "application/json" } ], "cookies": [],
          "postData": { "mimeType": "application/json", "text": "{\"ProductID\":\"SKU-88231-ALPHA\",\"quantity\":3}" } },
        "response": { "status": 200, "headers": [ { "name": "Content-Type", "value": "application/json" } ], "content": { "mimeType": "application/json", "text": "{\"cartItems\":1}" } }
      },
      {
        "startedDateTime": "2026-01-01T10:00:09.000Z", "time": 80,
        "comment": "Place order — consumes product as abbreviated prodId; server CREATES orderId (runtime)",
        "request": { "method": "POST", "url": "https://shop.example.com/api/orders", "headers": [ { "name": "Content-Type", "value": "application/json" } ], "cookies": [],
          "postData": { "mimeType": "application/json", "text": "{\"lines\":[{\"prodId\":\"SKU-88231-ALPHA\",\"qty\":3}]}" } },
        "response": { "status": 201, "headers": [ { "name": "Content-Type", "value": "application/json" } ], "content": { "mimeType": "application/json", "text": "{\"orderId\":\"ORD-5501-2026\",\"status\":\"NEW\"}" } }
      },
      {
        "startedDateTime": "2026-01-01T10:00:12.000Z", "time": 45,
        "comment": "Read order — consumes the CREATED orderId in the path",
        "request": { "method": "GET", "url": "https://shop.example.com/api/orders/ORD-5501-2026", "headers": [ { "name": "Accept", "value": "application/json" } ], "cookies": [] },
        "response": { "status": 200, "headers": [ { "name": "Content-Type", "value": "application/json" } ], "content": { "mimeType": "application/json", "text": "{\"orderId\":\"ORD-5501-2026\",\"status\":\"NEW\"}" } }
      },
      {
        "startedDateTime": "2026-01-01T10:00:15.000Z", "time": 50,
        "comment": "Update order — consumes created orderId (body) AND existing product as SKU field",
        "request": { "method": "PUT", "url": "https://shop.example.com/api/orders/ORD-5501-2026", "headers": [ { "name": "Content-Type", "value": "application/json" } ], "cookies": [],
          "postData": { "mimeType": "application/json", "text": "{\"orderId\":\"ORD-5501-2026\",\"sku\":\"SKU-88231-ALPHA\",\"note\":\"rush\"}" } },
        "response": { "status": 200, "headers": [ { "name": "Content-Type", "value": "application/json" } ], "content": { "mimeType": "application/json", "text": "{\"ok\":true}" } }
      }
    ]
  }
}
